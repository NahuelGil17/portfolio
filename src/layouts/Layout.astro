---
interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description = title, image } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="profile" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{imageUrl && <meta property="og:image" content={imageUrl} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{imageUrl && <meta name="twitter:image" content={imageUrl} />}
		<script is:inline>
			try {
				const stored = localStorage.getItem("theme");
				if (stored === "light" || stored === "dark") {
					document.documentElement.dataset.theme = stored;
				}
			} catch {}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--bg: #ffffff;
		--surface: #f4f5f4;
		--surface-hover: #e9ebe9;
		--border: #e4e6e4;
		--text: #111311;
		--text-strong: #000000;
		--text-muted: #4d524d;
		--text-subtle: #5f655f;
		--accent: #0a7a2a;
		--accent-soft: #e3f3e7;
		--accent-hover: #086322;
		--accent-contrast: #ffffff;
		--focus: #0a7a2a;

		--font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
		--font-mono: ui-monospace, Menlo, Monaco, Consolas, "Liberation Mono", monospace;

		--radius: 8px;
		--measure: 700px;
		--ease-out: cubic-bezier(0.16, 1, 0.3, 1);
		color-scheme: light;
	}

	/* Dark tokens: follow the OS unless the visitor picked a theme (data-theme on <html>). */
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme="light"]) {
			--bg: #0e100e;
			--surface: #1a1d1a;
			--surface-hover: #242824;
			--border: #2a2e2a;
			--text: #e8ebe8;
			--text-strong: #ffffff;
			--text-muted: #b3b9b3;
			--text-subtle: #9aa19a;
			--accent: #4ade80;
			--accent-soft: #163a22;
			--accent-hover: #6ee7a0;
			--accent-contrast: #062b13;
			--focus: #4ade80;
			color-scheme: dark;
		}
	}

	:root[data-theme="dark"] {
		--bg: #0e100e;
		--surface: #1a1d1a;
		--surface-hover: #242824;
		--border: #2a2e2a;
		--text: #e8ebe8;
		--text-strong: #ffffff;
		--text-muted: #b3b9b3;
		--text-subtle: #9aa19a;
		--accent: #4ade80;
		--accent-soft: #163a22;
		--accent-hover: #6ee7a0;
		--accent-contrast: #062b13;
		--focus: #4ade80;
		color-scheme: dark;
	}

	*, *::before, *::after {
		box-sizing: border-box;
	}

	html {
		font-family: var(--font-sans);
		background-color: var(--bg);
		color: var(--text);
		-webkit-text-size-adjust: 100%;
		text-rendering: optimizeLegibility;
		scrollbar-color: var(--border) var(--bg);
	}

	body,
	figure {
		margin: 0;
		padding: 0;
	}

	::selection {
		background: var(--accent-soft);
		color: var(--text-strong);
	}

	a {
		color: inherit;
		text-decoration: none;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 3px;
		border-radius: 4px;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	h1, h2, h3, h4 {
		margin: 0;
		font-family: var(--font-sans);
		color: var(--text-strong);
		text-wrap: balance;
	}

	p {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
		margin: 0;
		text-wrap: pretty;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		border-radius: 6px;
		background: var(--surface);
		color: var(--text-muted);
		font-size: 0.78rem;
		font-weight: 500;
		line-height: 1.4;
		padding: 0.2rem 0.55rem;
	}

	.print {
		display: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after {
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
		}
	}

	@media print {
		:root {
			--bg: #ffffff;
			--surface: #f2f2f2;
			--border: #dddddd;
			--text: #000000;
			--text-strong: #000000;
			--text-muted: #333333;
			--text-subtle: #444444;
		}

		.no-print {
			display: none !important;
		}

		.print {
			display: block !important;
		}

		astro-dev-toolbar {
			display: none !important;
		}

		article {
			break-inside: avoid;
		}
	}
</style>
