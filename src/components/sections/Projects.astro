---
import Section from "@/components/Section.astro";
import { projects } from "@/cv.json";
---

<Section title="Projects">
  <ul class="grid">
    {
      projects.map((project) => {
        const highlights: string[] = ("highlights" in project && project.highlights) || [];
        const startYear = new Date(project.startDate).getFullYear();
        const endYear = project.endDate ? new Date(project.endDate).getFullYear() : "Present";
        const period = startYear === endYear ? `${startYear}` : `${startYear} – ${endYear}`;
        return (
          <li>
            <article>
              <header>
                <h3>
                  {project.url ? (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`See the project ${project.name}`}
                    >
                      {project.name}
                    </a>
                  ) : (
                    project.name
                  )}
                </h3>
                <p class="meta">
                  <time datetime={project.startDate}>{period}</time>
                  {project.roles.length > 0 && <span>{project.roles.join(" · ")}</span>}
                </p>
              </header>
              <div class="body">
                <p>{project.description}</p>
                {highlights.length > 0 && (
                  <ul class="highlights">
                    {highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}
              </div>
              {project.keywords.length > 0 && (
                <ul class="stack" aria-label={`Tech stack of ${project.name}`}>
                  {project.keywords.map((keyword) => (
                    <li class="tag">{keyword}</li>
                  ))}
                </ul>
              )}
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 12px;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    transition: border-color 0.2s var(--ease-out);
  }

  article:hover {
    border-color: var(--text-subtle);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 10px;
    row-gap: 2px;
    margin-top: 4px;
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .meta time {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .body {
    flex: 1;
  }

  p {
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .highlights {
    margin-top: 10px;
    padding-left: 1.1em;
    list-style: disc;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media print {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    article {
      padding: 12px;
    }
  }
</style>
