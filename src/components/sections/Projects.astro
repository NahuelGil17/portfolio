---
import Section from "@/components/Section.astro";
import { projects } from "@/cv.json";
---

<Section title="Projects">
  <ul>
    {
      projects.map((project) => (
        <li>
          <article>
            <header>
              <h3>
                {project.url ? (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={`See the project ${project.name}`}
                  >
                    {project.name}
                  </a>
                ) : (
                  project.name
                )}
                {project.isActive && (
                  <span class="status" title="Active project">
                    <span class="visually-hidden">Active</span>
                  </span>
                )}
              </h3>
              <p>{project.description}</p>
            </header>
            <ul class="highlights" aria-label={`Highlights of ${project.name}`}>
              {project.highlights.map((highlight) => (
                <li class="tag">{highlight}</li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 12px;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    transition: border-color 0.2s var(--ease-out);
  }

  article:hover {
    border-color: var(--text-subtle);
  }

  header {
    flex: 1;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    line-height: 1.3;
    margin-bottom: 8px;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  p {
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media print {
    ul:not(.highlights) {
      grid-template-columns: 1fr 1fr;
    }
    article {
      padding: 12px;
    }
  }
</style>
