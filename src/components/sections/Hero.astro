---
import { basics } from "@/cv.json";
import Section from "@/components/Section.astro";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import WorldMap from "@/icons/WorldMap.astro";
import Download from "@/icons/Download.astro";
import Moon from "@/icons/Moon.astro";
import Sun from "@/icons/Sun.astro";
import Command from "@/icons/Command.astro";

const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;

const SOCIAL_ICONS: Record<string, any> = {
  LinkedIn,
  GitHub,
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;
const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ");
---

<Section>
  <div class="container">
    <div class="info">
      <h1>{name}</h1>
      <p class="label">{label}</p>
      <p class="location">
        <WorldMap />
        {city}, {region}
      </p>
      <footer class="print">
        {printInfo}
      </footer>
      <footer class="no-print">
        {
          phone && (
            <a href={`tel:${phone.replace(/[^\d+]/g, "")}`} aria-label={`Call ${name}`} title={phone}>
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network];
            return (
              <a
                href={url}
                aria-label={`${name} on ${network}`}
                title={network}
                target="_blank"
                rel="noopener noreferrer"
              >
                {Icon ? <Icon /> : network}
              </a>
            );
          })
        }
        <span class="divider" aria-hidden="true"></span>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Use dark theme" title="Toggle theme">
          <span class="moon"><Moon /></span>
          <span class="sun"><Sun /></span>
        </button>
        <button
          type="button"
          class="keyboard-only"
          data-command-menu
          aria-label="Open command menu"
          aria-keyshortcuts="Control+K"
          title="Command menu (Ctrl + K)"
        >
          <Command />
        </button>
      </footer>
      <div class="actions no-print">
        {
          email && (
            <a class="button primary" href={`mailto:${email}`}>
              <span class="icon" aria-hidden="true"><Mail /></span>
              Email me
            </a>
          )
        }
        <button class="button" type="button" data-print>
          <Download />
          Save as PDF
        </button>
      </div>
    </div>
    <figure>
      <img src={image} alt={`Portrait of ${name}`} width="128" height="128" />
    </figure>
  </div>
</Section>

<style>
  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h1 {
    font-size: clamp(2rem, 1.6rem + 2vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .label {
    color: var(--text);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.4;
    text-wrap: balance;
  }
  .location {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  img {
    display: block;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 128px;
    height: auto;
    border-radius: 16px;
  }

  footer {
    color: var(--text-muted);
    font-size: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  footer button {
    padding: 0;
    font: inherit;
    background: transparent;
    cursor: pointer;
  }

  .divider {
    align-self: center;
    width: 1px;
    height: 20px;
    margin-inline: 4px;
    background: var(--border);
  }

  .theme-toggle .sun,
  .theme-toggle[aria-pressed="true"] .moon {
    display: none;
  }

  .theme-toggle[aria-pressed="true"] .sun,
  .theme-toggle .moon {
    display: inline-flex;
  }

  @media (pointer: coarse) {
    .keyboard-only {
      display: none !important;
    }
  }

  footer a,
  footer button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    border: 1px solid var(--border);
    height: 40px;
    width: 40px;
    border-radius: var(--radius);
    transition: color 0.2s var(--ease-out), background-color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }
  footer button:hover,
  footer a:hover {
    color: var(--text-strong);
    background-color: var(--surface);
    border-color: var(--surface-hover);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-strong);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 0.2s var(--ease-out), border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .icon {
    display: inline-flex;
  }

  .button:hover {
    background: var(--surface);
    border-color: var(--surface-hover);
  }

  .button.primary {
    color: var(--accent-contrast);
    background: var(--accent);
    border-color: var(--accent);
  }

  .button.primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @media (max-width: 560px) {
    .actions .button {
      flex: 1 1 auto;
      justify-content: center;
    }
  }

  @media (max-width: 560px) {
    .container {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 20px;
    }
    img {
      width: 96px;
    }
  }

  @media print {
    footer.print {
      font-family: var(--font-mono);
      font-size: 0.75rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-print]").forEach((button) => {
    button.addEventListener("click", () => window.print());
  });

  const root = document.documentElement;
  const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === "dark" : darkQuery.matches;

  const syncToggles = () => {
    const dark = isDark();
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((toggle) => {
      toggle.setAttribute("aria-pressed", String(dark));
      toggle.setAttribute("aria-label", dark ? "Use light theme" : "Use dark theme");
    });
  };

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      syncToggles();
    });
  });

  darkQuery.addEventListener("change", syncToggles);
  syncToggles();
</script>
