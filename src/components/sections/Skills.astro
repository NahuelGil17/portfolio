---
import Section from "@/components/Section.astro";

import { skills } from "@/cv.json";
---

<Section title="Skills">
  <ul>
    {skills.map(({ name }) => <li class="tag">{name}</li>)}
  </ul>
</Section>

<style>
  ul {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  li {
    font-size: 0.85rem;
    color: var(--text);
    padding: 0.3rem 0.7rem;
  }
</style>
