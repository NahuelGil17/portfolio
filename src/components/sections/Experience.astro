---
import Section from "@/components/Section.astro";

import { work } from "@/cv.json";

const formatYear = (date: string) => new Date(date).getUTCFullYear();
---

<Section title="Experience">
  <ul>
    {
      work.map(({ name, url, startDate, endDate, position, summary, highlights }) => {
        const startYear = formatYear(startDate);
        const endYear = endDate != null ? formatYear(endDate) : "Present";
        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>
                    {url ? (
                      <a href={url} target="_blank" rel="noopener noreferrer">
                        {name}
                      </a>
                    ) : (
                      name
                    )}
                  </h3>
                  <p class="position">{position}</p>
                </div>
                <time datetime={startDate}>
                  {startYear} – {endYear}
                </time>
              </header>
              <p>{summary}</p>
              <ul class="highlights" aria-label={`Highlights at ${name}`}>
                {highlights.map((highlight) => (
                  <li class="tag">{highlight}</li>
                ))}
              </ul>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.3;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .position {
    color: var(--text);
    font-weight: 500;
    font-size: 0.92rem;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 8px;
  }

  time {
    flex-shrink: 0;
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .highlights {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  @media (max-width: 560px) {
    header {
      flex-direction: column;
      gap: 4px;
    }
    time {
      order: -1;
    }
  }
</style>
