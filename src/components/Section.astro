---
interface Props {
  title?: string;
}

const { title } = Astro.props;
const headingId = title ? `section-${title.toLowerCase().replace(/\s+/g, "-")}` : undefined;
---

<section aria-labelledby={headingId}>
  {title && <h2 id={headingId}>{title}</h2>}
  <slot />
</section>

<style>
  section {
    max-width: var(--measure);
    margin: 0 auto 56px;
  }
  h2 {
    margin-bottom: 16px;
    font-weight: 700;
    line-height: 1.3;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  @media print {
    section {
      margin-bottom: 28px;
    }
  }
</style>
